---
---
<form id="login-form" class="admin-login-form space-y-5">
  <div class="admin-login-field"><label for="usuario" class="sr-only">Usuario</label><span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="7" r="3.5"/><path d="M5 20c.6-4.2 3.1-6.5 7-6.5s6.4 2.3 7 6.5" stroke-width="2" stroke-linecap="round"/></svg></span><input id="usuario" name="usuario" placeholder="Usuario" autocomplete="username" /></div>
  <div class="admin-login-field"><label for="contrasena" class="sr-only">Contraseña</label><span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="5" y="10" width="14" height="10" rx="1.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" stroke-width="2" stroke-linecap="round"/></svg></span><input id="contrasena" name="contrasena" type="password" placeholder="Contraseña" autocomplete="current-password" /></div>
  <p id="login-error" class="hidden text-sm text-red-600"></p>
  <button class="admin-login-button w-full" type="submit">Iniciar sesión</button>
</form>

<style>
  .admin-login-form { padding: 0 .5rem; }
  .admin-login-field { display: flex; align-items: center; gap: .9rem; min-height: 72px; padding: .75rem 1.25rem; border: 2px solid #dce2e5; border-radius: 1.25rem; background: #ffffff; box-shadow: 0 4px 12px rgba(18, 59, 82, .12); }
  .admin-login-field > span { display: flex; color: #123b52; }
  .admin-login-field svg { width: 30px; height: 30px; stroke: currentColor; }
  .admin-login-field input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: #123b52; font-size: 1.15rem; }
  .admin-login-field input::placeholder { color: #64748b; opacity: 1; }
  .admin-login-field:focus-within { border-color: #123b52; box-shadow: 0 0 0 3px rgba(18, 59, 82, .14); }
  .admin-login-button { border: 0; border-radius: 999px; padding: .9rem 1.25rem; background: #c46b84; color: #4a172b; font-size: 1.2rem; font-weight: 600; cursor: pointer; transition: background-color .2s, transform .2s; }
  .admin-login-button:hover { background: #8f3556; color: #fff; transform: translateY(-1px); }
</style>
<script>
  import { login } from '../features/auth/auth.api'
  import { loginSchema } from '../features/auth/auth.schemas'
  const form = document.querySelector<HTMLFormElement>('#login-form')!
  const error = document.querySelector<HTMLParagraphElement>('#login-error')!
  form.addEventListener('submit', async (event) => {
    event.preventDefault(); error.classList.add('hidden')
    const values = Object.fromEntries(new FormData(form))
    const parsed = loginSchema.safeParse(values)
    if (!parsed.success) { error.textContent = parsed.error.issues[0].message; error.classList.remove('hidden'); return }
    try { await login(parsed.data); window.location.href = '/admin/products' }
    catch (reason) { error.textContent = reason instanceof Error ? reason.message : 'No fue posible iniciar sesión'; error.classList.remove('hidden') }
  })
</script>
