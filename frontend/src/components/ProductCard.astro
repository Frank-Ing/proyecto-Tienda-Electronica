---
const { product } = Astro.props
const image = product.imagen_url || `/images/${product.categoria}.svg`
const whatsappMessage = encodeURIComponent(`Hola, Tienda Loren.\n\nQuiero consultar la compra de este producto:\nProducto: ${product.modelo_producto}\nCategoría: ${product.categoria}\nPrecio: Bs. ${Number(product.precio).toFixed(2)}`)
---
<article class="product-card group overflow-hidden rounded-2xl border bg-white p-4 transition duration-300 hover:-translate-y-1 hover:scale-[1.02]">
  <div class="flex h-44 items-center justify-center rounded-xl bg-[#f7f7f7] p-5"><img src={image} alt={product.modelo_producto} class="max-h-full w-full object-contain" /></div>
  <p class="mt-4 text-xs uppercase tracking-wide text-slate-400">{product.categoria}</p>
  <h3 class="mt-1 min-h-12 font-semibold text-[#123b52]">{product.modelo_producto}</h3>
  <div class="mt-3 flex items-center justify-between"><strong class="text-xl text-[#123b52]">Bs. {Number(product.precio).toFixed(2)}</strong><span class="text-xs text-slate-500">Stock: {product.stock}</span></div>
  <a href={`https://wa.me/59176035687?text=${whatsappMessage}`} target="_blank" rel="noopener noreferrer" class="mt-4 block rounded-full bg-[#25D366] px-4 py-2 text-center text-sm font-semibold text-white transition hover:bg-[#1ebe5d]">Comprar por WhatsApp</a>
</article>
