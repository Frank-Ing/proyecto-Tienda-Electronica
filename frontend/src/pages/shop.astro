---
import PublicLayout from '../layouts/PublicLayout.astro'
import Header from '../components/Header.astro'
import { categories } from '../features/products/products.schemas'
---
<PublicLayout title="Shop | Electro."><Header /><main class="mx-auto max-w-7xl px-6 py-10"><div class="mb-8"><p class="text-sm font-semibold uppercase tracking-widest text-yellow-600">Catálogo</p><h1 class="text-4xl font-bold text-[#123b52]">Todos los productos</h1></div><div class="mb-8 grid gap-4 md:grid-cols-[1fr_240px_auto]"><input id="modelo" class="input-field" placeholder="Buscar por modelo" /><select id="categoria" class="input-field"><option value="">Todas las categorías</option>{categories.map((category) => <option value={category}>{category}</option>)}</select><button id="search" class="button-primary">Buscar</button></div><div id="products" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4"><p class="text-slate-500">Cargando productos...</p></div></main></PublicLayout>
<script>
  import { getProducts } from '../features/products/products.api'
  const target = document.querySelector('#products')!; const model = document.querySelector<HTMLInputElement>('#modelo')!; const category = document.querySelector<HTMLSelectElement>('#categoria')!
  const load = async () => { try { const { data } = await getProducts({ modelo: model.value, categoria: category.value }); target.innerHTML = data.map((p) => { const message = encodeURIComponent(`Hola, Tienda Loren.\n\nQuiero consultar la compra de este producto:\nProducto: ${p.modelo_producto}\nCategoría: ${p.categoria}\nPrecio: Bs. ${Number(p.precio).toFixed(2)}`); return `<article class="rounded-2xl border border-slate-100 bg-white p-4 shadow-sm"><div class="flex h-44 items-center justify-center rounded-xl bg-[#f7f7f7]"><img src="${p.imagen_url || `/images/${p.categoria}.svg`}" alt="${p.modelo_producto}" class="max-h-full w-full object-contain p-5"></div><p class="mt-4 text-xs uppercase text-slate-400">${p.categoria}</p><h3 class="mt-1 font-semibold text-[#123b52]">${p.modelo_producto}</h3><div class="mt-3 flex justify-between"><strong class="text-xl text-[#123b52]">Bs. ${Number(p.precio).toFixed(2)}</strong><span class="text-xs text-slate-500">Stock: ${p.stock}</span></div><a href="https://wa.me/59176035687?text=${message}" target="_blank" rel="noopener noreferrer" class="mt-4 block rounded-full bg-[#25D366] px-4 py-2 text-center text-sm font-semibold text-white">Comprar por WhatsApp</a></article>` }).join('') || '<p class="text-slate-500">No se encontraron productos.</p>' } catch { target.innerHTML = '<p class="text-red-600">No fue posible cargar el catálogo.</p>' } }
  document.querySelector('#search')?.addEventListener('click', load); load()
</script>

<style>
  :global(body) { background: #6491ed; }
  :global(header), :global(header > div) { background-color: #6491ed !important; border-color: #6491ed !important; }
  :global(header .text-\[\#123b52\]) { color: #ffffff !important; }
  main { background: #6491ed; }
</style>
