---
import PublicLayout from '../layouts/PublicLayout.astro'
import Header from '../components/Header.astro'
import ProductCard from '../components/ProductCard.astro'
---
<PublicLayout>
  <Header />
  <main>
    <section class="hero-neon overflow-hidden"><div class="mx-auto grid max-w-7xl items-center gap-10 px-6 py-16 md:grid-cols-2 md:py-24"><div class="relative z-10"><p class="mb-4 font-semibold uppercase tracking-[0.2em] text-[#6ad7e5]">Tienda Loren tecnología</p><h1 class="text-5xl font-light leading-tight text-white md:text-7xl">EL FUTURO ES HOY,<br /><strong class="font-bold">OÍSTE VIEJO</strong></h1><p class="mt-5 max-w-xl text-lg text-[#fff1f2]">Encuentra celulares, laptops, monitores y accesorios. Consulta disponibilidad y compra directamente por WhatsApp.</p><div class="mt-8 flex flex-wrap gap-3"><a class="button-primary" href="/shop">Explorar productos</a><a class="rounded-full bg-[#25D366] px-5 py-3 font-semibold text-white transition hover:bg-[#1ebe5d]" href="https://wa.me/59176035687" target="_blank" rel="noopener noreferrer">Escribir por WhatsApp</a></div></div><img src="/images/laptop_586.webp" alt="Laptop" class="mx-auto max-h-[390px] w-full rounded-2xl object-contain" /></div></section>
    <section class="mx-auto max-w-7xl px-6 py-10"><div class="mb-6 flex items-end justify-between"><div><p class="text-sm font-semibold uppercase tracking-widest text-yellow-600">Selección Tienda Loren</p><h2 class="text-3xl font-bold text-[#123b52]">Productos destacados</h2></div><a href="/shop" class="font-semibold text-[#123b52]">Ver todos →</a></div><div id="featured-products" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4"><p class="text-slate-500">Cargando productos...</p></div></section>
  </main>
</PublicLayout>
<script>
  import { getProducts } from '../features/products/products.api'
  const target = document.querySelector('#featured-products')!
  getProducts().then(({ data }) => { target.innerHTML = data.slice(0, 4).map((p) => { const message = encodeURIComponent(`Hola, Tienda Loren.\n\nQuiero consultar la compra de este producto:\nProducto: ${p.modelo_producto}\nCategoría: ${p.categoria}\nPrecio: Bs. ${Number(p.precio).toFixed(2)}`); return `<article class="rounded-2xl border border-slate-100 bg-white p-4 shadow-sm"><div class="flex h-44 items-center justify-center rounded-xl bg-[#f7f7f7]"><img src="${p.imagen_url || `/images/${p.categoria}.svg`}" alt="${p.modelo_producto}" class="max-h-full w-full object-contain p-5"></div><p class="mt-4 text-xs uppercase text-slate-400">${p.categoria}</p><h3 class="mt-1 font-semibold text-[#123b52]">${p.modelo_producto}</h3><strong class="mt-3 block text-xl text-[#123b52]">Bs. ${Number(p.precio).toFixed(2)}</strong><a href="https://wa.me/59176035687?text=${message}" target="_blank" rel="noopener noreferrer" class="mt-4 block rounded-full bg-[#25D366] px-4 py-2 text-center text-sm font-semibold text-white">Comprar por WhatsApp</a></article>` }).join('') }).catch(() => { target.innerHTML = '<p class="text-slate-500">Los productos estarán disponibles próximamente.</p>' })
</script>

<style>
  :global(body) { background: #6491ed; }
  :global(header), :global(header > div) { background-color: #6491ed !important; border-color: #6491ed !important; }
  :global(header .text-\[\#123b52\]) { color: #ffffff !important; }
  main { background: #6491ed; }
  main > section:first-child, main > section:nth-child(2), main > section:nth-child(3) { background: #6491ed !important; }
  #featured-products article { background: #ffffff; border: 2px solid #c98298; border-color: #c98298; box-shadow: 0 16px 32px rgba(107, 31, 58, .24), 0 4px 9px rgba(107, 31, 58, .14); transform: translateY(-4px); transition: transform .3s ease, box-shadow .3s ease; }
  #featured-products article > div:first-child { border: 1px solid #e3b5c3; background: #fff8fa; }
  #featured-products article:hover { transform: translateY(-8px) scale(1.02); box-shadow: 0 20px 38px rgba(107, 31, 58, .3), 0 5px 12px rgba(107, 31, 58, .16); }
</style>
