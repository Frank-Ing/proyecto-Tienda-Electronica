---
import PublicLayout from '../../../layouts/PublicLayout.astro'
import Header from '../../../components/Header.astro'
---
<PublicLayout title="Editar producto | Electro."><Header admin /><main class="mx-auto max-w-2xl px-6 py-10"><a href="/admin/products" class="text-sm font-semibold text-[#123b52]">← Volver a productos</a><h1 class="mb-8 mt-4 text-4xl font-bold text-[#123b52]">Editar producto</h1><div id="form-container"><p class="text-slate-500">Cargando producto...</p></div></main></PublicLayout>
<script>
  import { getProduct, updateProduct } from '../../../features/products/products.api'
  import { getToken } from '../../../lib/storage'
  const id = Number(new URLSearchParams(location.search).get('id'))
  const container = document.querySelector('#form-container')!
  if (!getToken() || !id) location.href = '/login'
  getProduct(id).then(({ data: product }) => { container.innerHTML = `<form id="product-form" class="space-y-5 rounded-2xl border border-slate-100 bg-white p-6 shadow-sm"><div><label for="modelo_producto" class="mb-2 block text-sm font-semibold text-[#123b52]">Modelo</label><input id="modelo_producto" name="modelo_producto" value="${product.modelo_producto}" class="input-field"></div><div class="grid gap-5 md:grid-cols-2"><div><label for="precio" class="mb-2 block text-sm font-semibold text-[#123b52]">Precio</label><input id="precio" name="precio" type="number" min="0.01" step="0.01" value="${product.precio}" class="input-field"></div><div><label for="stock" class="mb-2 block text-sm font-semibold text-[#123b52]">Stock</label><input id="stock" name="stock" type="number" min="0" value="${product.stock}" class="input-field"></div></div><div><label for="categoria" class="mb-2 block text-sm font-semibold text-[#123b52]">Categoría</label><select id="categoria" name="categoria" class="input-field">${['celular','laptop','monitor','teclado','mouse','audifonos'].map((category) => `<option value="${category}" ${category === product.categoria ? 'selected' : ''}>${category}</option>`).join('')}</select></div><div><label for="imagen_url" class="mb-2 block text-sm font-semibold text-[#123b52]">URL de imagen <span class="font-normal text-slate-400">(opcional)</span></label><input id="imagen_url" name="imagen_url" type="url" value="${product.imagen_url ?? ''}" placeholder="https://ejemplo.com/imagen.jpg" class="input-field"></div><p id="product-error" class="hidden text-sm text-red-600"></p><button class="button-primary w-full" type="submit">Guardar cambios</button></form>`; const form = document.querySelector<HTMLFormElement>('#product-form')!; form.addEventListener('submit', async (event) => { event.preventDefault(); const values = Object.fromEntries(new FormData(form)); const { productSchema } = await import('../../../features/products/products.schemas'); const parsed = productSchema.safeParse(values); const error = document.querySelector('#product-error')!; if (!parsed.success) { error.textContent = parsed.error.issues[0].message; error.classList.remove('hidden'); return } await updateProduct(id, parsed.data); location.href = '/admin/products' }) }).catch(() => { container.innerHTML = '<p class="text-red-600">No fue posible cargar el producto.</p>' })
</script>
