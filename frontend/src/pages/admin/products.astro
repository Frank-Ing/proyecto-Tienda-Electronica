---
import PublicLayout from '../../layouts/PublicLayout.astro'
import Header from '../../components/Header.astro'
import { categories } from '../../features/products/products.schemas'
---
<PublicLayout title="Productos | Electro."><Header admin /><main class="mx-auto max-w-7xl px-6 py-10"><div class="flex flex-wrap items-end justify-between gap-4"><div><p class="text-sm font-semibold uppercase tracking-widest text-yellow-600">Administración</p><h1 class="text-4xl font-bold text-[#123b52]">Productos</h1></div><button id="logout" class="button-secondary">Cerrar sesión</button></div><section class="mt-8 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm"><div class="grid gap-4 md:grid-cols-[1fr_220px_auto]"><input id="modelo" class="input-field" placeholder="Buscar por modelo" /><select id="categoria" class="input-field"><option value="">Todas las categorías</option>{categories.map((category) => <option value={category}>{category}</option>)}</select><button id="search" class="button-primary">Buscar</button></div></section><section class="mt-8 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm"><div class="mb-5 flex items-center justify-between"><h2 class="text-xl font-bold text-[#123b52]">Inventario</h2><a href="/admin/products/nuevo" class="button-primary">Nuevo producto</a></div><div id="message" class="mb-4 hidden rounded-lg p-3 text-sm"></div><div class="overflow-x-auto"><table class="w-full min-w-[760px] text-left text-sm"><thead class="border-b text-slate-500"><tr><th class="p-3">Imagen</th><th class="p-3">Modelo</th><th class="p-3">Categoría</th><th class="p-3">Precio</th><th class="p-3">Stock</th><th class="p-3">Acciones</th></tr></thead><tbody id="products-body"></tbody></table></div></section></main></PublicLayout>
<script>
  import { getProducts, deleteProduct } from '../../features/products/products.api'
  import { logout } from '../../features/auth/auth.api'
  import { clearSession, getToken } from '../../lib/storage'
  const body = document.querySelector('#products-body')!
  const message = document.querySelector('#message')!
  const model = document.querySelector<HTMLInputElement>('#modelo')!
  const category = document.querySelector<HTMLSelectElement>('#categoria')!
  const showMessage = (text: string, error = false) => { message.textContent = text; message.className = `mb-4 rounded-lg p-3 text-sm ${error ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700'}` }
  const load = async () => { try { const { data } = await getProducts({ modelo: model.value, categoria: category.value }); body.innerHTML = data.map((p) => `<tr class="border-b"><td class="p-3"><div class="flex h-14 w-16 items-center justify-center rounded-lg border border-[#e3b5c3] bg-[#fff8fa] p-1"><img src="${p.imagen_url || `/images/${p.categoria}.svg`}" alt="${p.modelo_producto}" class="max-h-full max-w-full object-contain" /></div></td><td class="p-3 font-semibold text-[#123b52]">${p.modelo_producto}</td><td class="p-3">${p.categoria}</td><td class="p-3">$${Number(p.precio).toFixed(2)}</td><td class="p-3">${p.stock}</td><td class="p-3"><a href="/admin/products/editar?id=${p.identificador_producto}" class="mr-3 text-[#123b52] hover:underline">Editar</a><button data-id="${p.identificador_producto}" class="delete text-red-600 hover:underline">Eliminar</button></td></tr>`).join('') || '<tr><td colspan="6" class="p-8 text-center text-slate-500">No se encontraron productos.</td></tr>' } catch (e) { showMessage(e instanceof Error ? e.message : 'Error al cargar productos', true) } }
  if (!getToken()) window.location.href = '/login'
  document.querySelector('#search')?.addEventListener('click', load)
  document.querySelector('#logout')?.addEventListener('click', async () => { try { await logout() } finally { clearSession(); window.location.href = '/login' } })
  body.addEventListener('click', async (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.delete'); if (!button || !confirm('¿Eliminar este producto?')) return; try { await deleteProduct(Number(button.dataset.id)); await load(); showMessage('Producto eliminado') } catch (e) { showMessage(e instanceof Error ? e.message : 'No fue posible eliminar', true) } })
  load()
</script>
